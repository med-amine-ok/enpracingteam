# The settings of this PC, in one file (decision D-023): copy this file to .env at the root of the
# project (never committed, see .gitignore). Docker Compose reads it for the database (DB_NAME,
# DB_USER, DB_PASSWORD), Django for everything. A server uses its own file (backend/.env.prod).
DEBUG=True
# REQUIRED: a long random key (Django refuses to start with a weak one - check members.E001).
# Generate it with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# and paste the result after the "=" below. Never commit or share this value.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Number of trusted reverse proxies in front of Django (0 in local development;
# e.g. 1 behind a single Nginx). Used to read the real client IP for rate limits.
NUM_PROXIES=0
# General API limits (defaults: 60/minute per address without a session, 120/minute per member).
# Keep them; only the end-to-end test server raises them (frontend/playwright.config.ts).
# API_THROTTLE_ANON=60/minute
# API_THROTTLE_USER=120/minute

DB_NAME=enp_racing_team_erp
DB_USER=enp
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432


REDIS_URL=redis://localhost:6379/0
# Without Docker (no Redis), in development only: REDIS_URL=locmem://
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@enpracing.team
# Address of the web pages, for the links in the notification e-mails.
FRONTEND_URL=http://localhost:3000
