#: .\apps\communication\emails.py
#, python-format
msgid "Ranking of %(month)s published"
msgstr "نُشر ترتيب %(month)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"The monthly ranking of %(month)s is published: your score and your category "
"are in the ERP."
msgstr "نُشر الترتيب الشهري لـ%(month)s: نقطتك وفئتك موجودتان في نظام ERP."

#: .\apps\communication\emails.py
msgid ""
"The ranking supports feedback and development; it never triggers a sanction "
"by itself."
msgstr "يخدم الترتيب المتابعة والتطور، ولا يؤدي أبدًا إلى عقوبة تلقائية."

#: .\apps\communication\emails.py
#, python-format
msgid "Ranking to publish: %(month)s"
msgstr "ترتيب بانتظار النشر: %(month)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"%(month)s is over: check the scores and the department heads' marks, then "
"publish the ranking (within 7 days)."
msgstr ""
"انتهى %(month)s: راجع النقاط وتقييمات رؤساء الأقسام، ثم انشر الترتيب (في "
"غضون 7 أيام)."

#: .\apps\communication\emails.py
#, python-format
msgid "Breach reported: %(member)s"
msgstr "إبلاغ عن إخلال: %(member)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"%(actor)s reported a breach by %(member)s (%(ground)s). As their project "
"manager or the Bureau, you decide what follows: a warning, or nothing with a "
"reason."
msgstr ""
"أبلغ %(actor)s عن إخلال من %(member)s (%(ground)s). بصفتك رئيس المشروع أو "
"عضوًا في المكتب، تقرر ما يلي: إنذار، أو لا شيء مع ذكر السبب."

#: .\apps\communication\emails.py
#, python-format
msgid "Warning no. %(level)s of the season"
msgstr "الإنذار رقم %(level)s لهذا الموسم"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"You received warning no. %(level)s of the season (charter, art. 27). In the "
"ERP: the rule concerned and what is expected to correct it; you may give "
"your version."
msgstr ""
"تلقيت الإنذار رقم %(level)s لهذا الموسم (الميثاق، المادة 27). في نظام ERP: "
"القاعدة المعنية وما هو منتظر للتصحيح؛ ويمكنك تقديم روايتك."

#: .\apps\communication\emails.py
#, python-format
msgid "Exclusion to confirm: %(member)s"
msgstr "فصل بانتظار التأكيد: %(member)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"An exclusion of %(member)s awaits the Bureau's confirmation (%(cause)s)."
msgstr "فصل %(member)s بانتظار تأكيد المكتب (%(cause)s)."

#: .\apps\communication\emails.py
#, python-format
msgid "Volunteering of %(month)s"
msgstr "التطوع لشهر %(month)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"No volunteering is validated for you yet in %(month)s: the charter (art. 21) "
"asks each member for a day or a period of volunteering every month. Join an "
"activity, or organise one in the ERP."
msgstr ""
"لم يُعتمد لك أي تطوع بعد في %(month)s: يطلب الميثاق (المادة 21) من كل عضو "
"يومًا أو فترة تطوع كل شهر. انضم إلى نشاط أو نظّم واحدًا في نظام ERP."

#: .\apps\communication\emails.py
