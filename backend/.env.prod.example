# Production settings (docker-compose.prod.yml; knowledge base: PROJECTS/ERP/hosting_design.md).
# scripts\deploy_prod.ps1 copies this file to backend\.env.prod with new secrets (SECRET_KEY,
# DB_PASSWORD); fill in what is empty, then run it again. Never commit backend\.env.prod.

# --- The ERP's address and its data folder (also read by docker compose and Caddy) ---
ERP_DOMAIN=erp.example.org
ERP_DATA=C:/ERP
# The e-mail given to Let's Encrypt (certificate notices): the club's Gmail, for instance.
ERP_ACME_EMAIL=

# --- Django ---
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=erp.example.org,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://erp.example.org
CORS_ALLOWED_ORIGINS=https://erp.example.org
FRONTEND_URL=https://erp.example.org
# Caddy is the one proxy in front of Django: the visitor's address is the last one it adds.
NUM_PROXIES=1
# Browsers keep to HTTPS this long: 3600 (an hour) at first, 31536000 (a year) once all works.
SECURE_HSTS_SECONDS=3600

# --- Database (the "db" container; a password for production only) ---
DB_NAME=enp_racing_team_erp
DB_USER=enp
DB_PASSWORD=

# --- E-mails: a Google account (the school's or the club's Gmail) and an app password. Fill these
# lines with scripts\set_email.ps1 -EnvFile backend\.env.prod: it tests them before saving them. ---
EMAIL_BACKEND=apps.communication.mail.SMTPBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
