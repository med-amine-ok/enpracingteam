#, python-format
msgid "Due today: %(task)s"
msgstr "موعد التسليم اليوم: %(task)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"The task “%(task)s” (project %(project)s) is due on %(date)s and is not done "
"yet."
msgstr ""
"موعد تسليم المهمة «%(task)s» (المشروع %(project)s) هو %(date)s، ولم تُنجز بعد."

#: .\apps\communication\emails.py
#, python-format
msgid "Purchase to approve (Operations): %(part)s"
msgstr "شراء بانتظار مصادقة العمليات: %(part)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"%(requester)s asks for %(quantity)s × “%(part)s”; their leader approved it: "
"it awaits the approval of Operations."
msgstr ""
"طلب من %(requester)s: %(quantity)s × «%(part)s». صادق عليه المسؤول، وهو الآن "
"بانتظار مصادقة العمليات."

#: .\apps\communication\emails.py
#, python-format
msgid "Purchase to approve: %(part)s"
msgstr "شراء بانتظار المصادقة: %(part)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"%(requester)s asks for %(quantity)s × “%(part)s”: it awaits your approval."
msgstr ""
"طلب من %(requester)s: %(quantity)s × «%(part)s». الطلب بانتظار مصادقتك."

#: .\apps\communication\emails.py
msgid "place not given"
msgstr "مكان غير محدد"

#: .\apps\communication\emails.py
#, python-format
msgid "Low stock: %(part)s"
msgstr "مخزون منخفض: %(part)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"%(quantity)s left of “%(part)s” (%(place)s), at or below its threshold of "
"%(threshold)s: think of asking for a purchase."
msgstr ""
"بقي %(quantity)s × «%(part)s» (%(place)s)، عند الحد %(threshold)s أو دونه: "
"يُستحسن تقديم طلب شراء."

#: .\apps\communication\emails.py
#, python-format
msgid "Budget exceeded: %(unit)s %(fiscal_year)s"
msgstr "تجاوز الميزانية: %(unit)s %(fiscal_year)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"The expenses of %(unit)s for %(fiscal_year)s (%(spent)s DA) are now above "
"its budget of %(allocated)s DA."
msgstr ""
"نفقات %(unit)s لسنة %(fiscal_year)s (%(spent)s دج) تتجاوز الآن ميزانيتها "
"البالغة %(allocated)s دج."

#: .\apps\communication\emails.py
msgid "Someone"
msgstr "شخص ما"

