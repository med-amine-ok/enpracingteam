#, python-format
msgid ""
"“%(equipment)s” was to be back on %(date)s: bring it back to the workshop."
msgstr "كان يجب إرجاع «%(equipment)s» يوم %(date)s: أعِدها إلى الورشة."

#: .\apps\communication\emails.py
#, python-format
msgid "Your reservation of “%(equipment)s” on %(when)s is cancelled."
msgstr "أُلغي حجزك لـ«%(equipment)s» يوم %(when)s."

