# The web pages on Render (documentation/DEPLOY_RENDER_NEON.md): exactly the variables to put in the Render Web
# Service "enp-erp" (Environment tab). Set them before the first build: the two addresses are built into the pages;
# after a change, redeploy with "Clear build cache & deploy". Replace enp-erp and enp-erp-api with your names.

NODE_VERSION=24
NEXT_TELEMETRY_DISABLED=1
# The pages' OWN address: the browser talks only to it.
NEXT_PUBLIC_API_URL=https://enp-erp.onrender.com
# The API's address: the pages forward /api/… and /admin/… to it.
API_PROXY_URL=https://enp-erp-api.onrender.com
