#: .\apps\communication\emails.py
#, python-format
msgid "%(actor)s assigned you the task “%(task)s” (project %(project)s)."
msgstr "أُسندت إليك المهمة «%(task)s» (المشروع %(project)s) من طرف %(actor)s."

#: .\apps\communication\emails.py
msgid "You are its main assignee."
msgstr "لك المسؤولية الرئيسية عنها."

#: .\apps\communication\emails.py
#, python-format
msgid "Task assigned to you: %(task)s"
msgstr "مهمة مُسندة إليك: %(task)s"

#: .\apps\communication\emails.py
#, python-format
msgid "Validation awaited: %(subsystem)s"
msgstr "مصادقة منتظرة: %(subsystem)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"The steps of the subsystem “%(subsystem)s” (project %(project)s) before "
"“%(step)s” are done: it awaits your validation."
msgstr ""
"اكتملت مراحل النظام الفرعي «%(subsystem)s» (المشروع %(project)s) التي تسبق "
"«%(step)s»، وهو بانتظار مصادقتكم."

#: .\apps\communication\emails.py
#, python-format
msgid "🔴 Overdue: %(task)s"
msgstr "🔴 متأخرة: %(task)s"

#: .\apps\communication\emails.py
#, python-format
msgid ""
"The task “%(task)s” (project %(project)s) was due on %(date)s and is still "
"not done."
msgstr ""
"كان موعد تسليم المهمة «%(task)s» (المشروع %(project)s) يوم %(date)s، ولم "
"تُنجز بعد."

#: .\apps\communication\emails.py
#, python-format
msgid "Due in %(days)d day: %(task)s"
msgid_plural "Due in %(days)d days: %(task)s"
msgstr[0] "موعد التسليم بعد %(days)d يوم: %(task)s"
msgstr[1] "موعد التسليم بعد %(days)d يوم: %(task)s"
msgstr[2] "موعد التسليم بعد %(days)d يومين: %(task)s"
msgstr[3] "موعد التسليم بعد %(days)d أيام: %(task)s"
msgstr[4] "موعد التسليم بعد %(days)d يومًا: %(task)s"
msgstr[5] "موعد التسليم بعد %(days)d يوم: %(task)s"

