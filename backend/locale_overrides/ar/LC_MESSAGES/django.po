# --- Django admin: neutral wording ---
# Django's Arabic refers to any object with a masculine pronoun (لتغييره، تعديله، احذفه،
# له), wrong for feminine model names (قطعة، مهمة، حركة). Neutral wording instead.

#, python-format
msgid "Select %s to change"
msgstr "اختر %s للتعديل"

msgid "You may edit it again below."
msgstr "يمكن التعديل مرة أخرى أدناه."

#, python-brace-format
msgid ""
"The {name} “{obj}” was changed successfully. You may edit it again below."
msgstr "تم تعديل {name} “{obj}” بنجاح. يمكنك التعديل مجددًا أدناه."

msgid "Delete?"
msgstr "حذف؟"

#, python-format
msgid "%(name)s with ID “%(key)s” doesn’t exist. Perhaps it was deleted?"
msgstr "لا يوجد عنصر من %(name)s بالمعرّف «%(key)s». ربما حُذف؟"

# Typo in Django's Arabic ("تغديل" instead of "تعديل").
msgid "You don’t have permission to view or edit anything."
msgstr "ليس لديك إذن لعرض أو تعديل أي شيء."

